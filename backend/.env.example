# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/fantrio

# JWT Passwords
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=30d

# Mail Settings (SMTP)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
FROM_EMAIL=noreply@fantrio.com

# AWS S3 Storage Credentials
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=fantrio-media-storage

# ZegoCloud Calling Configuration
ZEGO_APP_ID=your_zegocloud_app_id
ZEGO_SERVER_SECRET=your_zegocloud_server_secret

# KYC Verification Configs (Veriff Example)
VERIFF_API_KEY=your_veriff_api_key
VERIFF_SECRET_KEY=your_veriff_secret_key
VERIFF_API_URL=https://stationapi.veriff.com

# Payment Gateways (Segpay Configs)
SEGPAY_MERCHANT_ID=your_segpay_merchant_id
SEGPAY_ETICKET_ID=your_segpay_eticket_id
SEGPAY_SECRET_KEY=your_segpay_secret_key
